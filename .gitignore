# Only the evaluation app is versioned here (deployed on Streamlit Community Cloud).
/*
!/.gitignore
!/requirements.txt
!/curation/
/curation/*
!/curation/evaluation/
# hidden from coders: model outputs per item; coder labels live on the `labels` branch
/curation/evaluation/data/key.csv
/curation/evaluation/models/
/curation/evaluation/labels/
/curation/evaluation/results/
__pycache__/
/curation/evaluation/round2/data/key.csv
/curation/evaluation/round2/labels/
!/evaluation/
/evaluation/*
!/evaluation/app.py
